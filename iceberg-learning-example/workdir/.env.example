# Copy this file to .env and replace the placeholder values.
# The values below are shared by workdir/spark-sql.sh and workdir/flink-sql.sh.
CATALOG_NAME=ice
CATALOG_URI=http://127.0.0.1:8181
CATALOG_WAREHOUSE=s3://warehouse
S3_ENDPOINT=http://127.0.0.1:9000
S3_PATH_STYLE_ACCESS=true
AWS_REGION=us-east-1
MINIO_ACCESS_KEY_ID=your-access-key
MINIO_SECRET_ACCESS_KEY=your-secret-key

# Override these when Spark, Flink, or the downloaded Iceberg jars live elsewhere.
SPARK_HOME=/opt/spark-3.5.9-bin-hadoop3
ICEBERG_LIB_DIR=/opt/iceberg-learning-example/iceberg-libs
FLINK_HOME=/opt/flink-1.20.5
# Existing labs are bounded SQL examples. Set streaming for later CDC labs.
FLINK_RUNTIME_MODE=batch

# Required by labs/06-streaming-cdc only. It must be an empty directory that
# every Flink TaskManager can read, for example file:///absolute/local/path.
CDC_INPUT_PATH=file:///tmp/iceberg-cdc-input

# Recommended for Flink: use a complete Hadoop client distribution rather than
# copying Hadoop's transitive dependencies into $FLINK_HOME/lib.
HADOOP_HOME=/opt/hadoop-3.3.4
HADOOP_CONF_DIR=$HADOOP_HOME/etc/hadoop
