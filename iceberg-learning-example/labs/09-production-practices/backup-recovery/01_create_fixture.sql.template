-- Copy this template outside Git and replace <ISOLATED_TABLE_LOCATION> with an
-- empty, dedicated table prefix. It must not be a shared Warehouse root.
CREATE NAMESPACE IF NOT EXISTS ice.learning_recovery;
DROP TABLE IF EXISTS ice.learning_recovery.orders_backup_fixture;

CREATE TABLE ice.learning_recovery.orders_backup_fixture (
    order_id BIGINT,
    customer_id BIGINT,
    order_status STRING,
    order_total DECIMAL(12, 2),
    event_time TIMESTAMP
) USING iceberg
PARTITIONED BY (days(event_time))
-- 默认为 s3://root-path/<namespace>/<table>, 这里使用自定义的源路径 s3://warehouse/labs/09/recovery-source/
LOCATION '<ISOLATED_TABLE_LOCATION>'
TBLPROPERTIES ('format-version' = '2', 'business-owner' = 'data-platform');

