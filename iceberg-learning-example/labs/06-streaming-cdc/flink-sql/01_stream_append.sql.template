-- Rendered by workdir/flink-cdc-sql.sh. Do not put credentials or a local path in Git.
SET 'execution.checkpointing.interval' = '10 s';
SET 'execution.checkpointing.mode' = 'EXACTLY_ONCE';
SET 'execution.checkpointing.externalized-checkpoint-retention' = 'RETAIN_ON_CANCELLATION';
SET 'pipeline.name' = 'iceberg-learning-cdc-append';

CREATE TEMPORARY TABLE cdc_input (
    event_id STRING,
    operation STRING,
    order_id BIGINT,
    event_version BIGINT,
    event_time TIMESTAMP(3),
    customer_id BIGINT,
    order_status STRING,
    order_total DECIMAL(12, 2),
    event_day DATE,
    WATERMARK FOR event_time AS event_time - INTERVAL '5' SECOND
) WITH (
    'connector' = 'filesystem',
    'path' = __CDC_INPUT_PATH__,
    'format' = 'json',
    'source.monitor-interval' = '5 s'
);

-- This job is intentionally append-only. The input directory is watched continuously;
-- copy one generated batch at a time, wait for a checkpoint, then cancel the job manually.
INSERT INTO ice.learning_cdc.orders_cdc_raw
SELECT event_id, operation, order_id, event_version, event_time,
       customer_id, order_status, order_total, event_day
FROM cdc_input;
